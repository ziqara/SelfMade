@SelfMade.Api_HostAddress = http://localhost:5221

### Регистрация нового пользователя (Проверка шифрования)
POST {{SelfMade.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "SuperUser",
  "email": "test2@mail.com",
  "password": "123"
}

### Создать категорию (чтобы было к чему привязывать активности)
POST {{SelfMade.Api_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Программирование",
  "description": "Изучение C# и бэкенда",
  "type": "Обучение"
}

### Посмотреть все категории (чтобы узнать их ID)
GET {{SelfMade.Api_HostAddress}}/api/categories
Accept: application/json

### Логин (чтобы получить токен)
POST {{SelfMade.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test2@mail.com",
  "password": "123"
}

### 

# ВСТАВЬ ТОКЕН СЮДА (скопируй из ответа на логин, БЕЗ КАВЫЧЕК)
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI0IiwiZW1haWwiOiJ0ZXN0MkBtYWlsLmNvbSIsImp0aSI6IjYxZDQyYzMyLTU0NjYtNDExOC05ZDMxLTczYjA5NWE1MmYzYyIsImV4cCI6MTc4NzczMzM2MCwiaXNzIjoiU2VsZk1hZGVBcGkiLCJhdWQiOiJTZWxmTWFkZUFwcCJ9.yEl7fExU_KRVJBJWqMRkI0r9fbkmE3gHRFzMlbtyVI4

### Создать активность (Защищенный эндпоинт)
POST {{SelfMade.Api_HostAddress}}/api/activities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": 3,
  "title": "Изучал JWT",
  "description": "Повесил замки на контроллеры",
  "durationMinutes": 60
}

### Получить мои активности (Защищенный эндпоинт)
GET {{SelfMade.Api_HostAddress}}/api/activities/my
Authorization: Bearer {{token}}
Accept: application/json

### Записать настроение за сегодня (Защищено)
POST {{SelfMade.Api_HostAddress}}/api/moods
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "score": 5,
  "note": "Отличное настроение, API работает как часы!"
}

### Получить совет от ИИ на сегодня (Защищено)
GET {{SelfMade.Api_HostAddress}}/api/analytics/daily
Authorization: Bearer {{token}}
Accept: application/json

### Добавить цель развития 
POST {{SelfMade.Api_HostAddress}}/api/userinterests
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": 3,
  "title": "Стать Senior C# разработчиком",
  "isDevelopmentGoal": true
}

### Посмотреть мои цели
GET {{SelfMade.Api_HostAddress}}/api/userinterests/my
Authorization: Bearer {{token}}
Accept: application/json


### Сохранить анкету профиля
POST {{SelfMade.Api_HostAddress}}/api/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "learningTrack": "C# ASP.NET Core, архитектура микросервисов, PostgreSQL",
  "currentLevel": "Junior+",
  "freeTimeStart": "19:30:00",
  "freeTimeEnd": "23:00:00",
  "sleepTime": "23:30:00",
  "preferredRest": "Научно-фантастические фильмы (Sci-Fi), книги по психологии, вечерние пешие прогулки",
  "dislikedRest": "Бег, шумные клубы, компьютерные игры"
}

### Получить персонализированный совет
GET {{SelfMade.Api_HostAddress}}/api/analytics/daily
Authorization: Bearer {{token}}
Accept: application/json